# ── GlucoTwin environment configuration ──────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Random seed for reproducibility
GLUCOTWIN_SEED=42

# Forecast horizon in minutes
GLUCOTWIN_HORIZON_MINUTES=120

# Lookback window: number of CGM readings to use as input
GLUCOTWIN_LOOKBACK_N=24

# Target tolerance: accept a target reading within ±N minutes of the horizon
GLUCOTWIN_TARGET_TOLERANCE_MINUTES=10

# Maximum gap (minutes) allowed within an input window before rejection
GLUCOTWIN_MAX_GAP_MINUTES=30

# Freshness threshold: forecast is withheld if latest reading is older than N minutes
GLUCOTWIN_FRESHNESS_THRESHOLD_MINUTES=20

# API configuration
GLUCOTWIN_API_HOST=127.0.0.1
GLUCOTWIN_API_PORT=8000

# Path to saved model artifact (relative to project root)
GLUCOTWIN_MODEL_PATH=artifacts/model_v0.1/model.joblib

# Path to processed data directory
GLUCOTWIN_DATA_DIR=data/processed
